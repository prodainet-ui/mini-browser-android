<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bar"
    android:orientation="vertical">

    <!-- Адресная строка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="4dp">

        <EditText
            android:id="@+id/address"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/address_bg"
            android:hint="@string/address_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:paddingStart="18dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/reload"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/round_ripple"
            android:contentDescription="Обновить"
            android:src="@drawable/ic_reload" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressBackgroundTint="@android:color/transparent"
        android:progressTint="@color/accent"
        android:visibility="invisible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white" />

        <!-- Список вкладок -->
        <LinearLayout
            android:id="@+id/tabsOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/overlay"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/tabsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/newTabFromList"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/pill_bg"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="+ Новая вкладка"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/closeTabs"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/round_ripple"
                    android:contentDescription="Закрыть список"
                    android:src="@drawable/ic_down" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/tabsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Поиск по странице -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/address_bg"
            android:hint="Найти на странице"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="56dp"
            android:paddingStart="8dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/findPrev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/round_ripple"
            android:contentDescription="Предыдущее"
            android:src="@drawable/ic_up" />

        <ImageButton
            android:id="@+id/findNext"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/round_ripple"
            android:contentDescription="Следующее"
            android:src="@drawable/ic_down" />

        <ImageButton
            android:id="@+id/findClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/round_ripple"
            android:contentDescription="Закрыть поиск"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Нижняя панель -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/round_ripple"
            android:contentDescription="Назад"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/forward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/round_ripple"
            android:contentDescription="Вперёд"
            android:src="@drawable/ic_forward" />

        <ImageButton
            android:id="@+id/home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/round_ripple"
            android:contentDescription="Начальная страница"
            android:src="@drawable/ic_home" />

        <FrameLayout
            android:id="@+id/tabsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/round_ripple"
            android:clickable="true"
            android:contentDescription="Вкладки"
            android:focusable="true">

            <TextView
                android:id="@+id/tabCount"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@drawable/tab_count_bg"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/icon"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/menu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/round_ripple"
            android:contentDescription="Меню"
            android:src="@drawable/ic_menu" />
    </LinearLayout>
</LinearLayout>
